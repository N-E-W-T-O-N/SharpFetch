<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SharpFetch</RootNamespace>
  </PropertyGroup>

  <!--
    Opt-in platform targets, exercised only by CI via -p:IncludePlatformTargets=true.
    Off by default so a plain `dotnet build` needs no extra SDK workloads.
    Apple targets are appended only on macOS hosts - the ios/tvos/maccatalyst/macos
    workloads cannot build anywhere else.
  -->
  <PropertyGroup Condition="'$(IncludePlatformTargets)' == 'true'">
    <TargetFrameworks>$(TargetFrameworks);net10.0-android;net10.0-browser</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IncludePlatformTargets)' == 'true' and $([MSBuild]::IsOSPlatform('OSX'))">
    <TargetFrameworks>$(TargetFrameworks);net10.0-ios;net10.0-tvos;net10.0-maccatalyst;net10.0-macos</TargetFrameworks>
  </PropertyGroup>
</Project>
