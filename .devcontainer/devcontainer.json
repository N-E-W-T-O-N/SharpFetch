// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
	"name": "C# (.NET)",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/dotnet",
	"features": {
		// Keep this in sync with the SDK feature band pinned in global.json -
		// the feature does not read global.json itself (an omitted "version"
		// defaults to "latest", which could land on a newer feature band than
		// global.json's rollForward: latestFeature will accept).
		"ghcr.io/devcontainers/features/dotnet:2": {
			"tabCompletions": true,
			"version": "10.0"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.vscode-dotnet-runtime",
				"ms-dotnettools.csdevkit",
				"redhat.vscode-xml"
			]
		}
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [5000, 5001],
	// "portsAttributes": {
	//		"5001": {
	//			"protocol": "https"
	//		}
	// }

	// Use 'postCreateCommand' to run commands after the container is created.
	// clang/zlib1g-dev: Native AOT toolchain for Linux, matching CI's aot-smoke
	// job. android/wasm-tools workloads: matches CI's platform-targets job,
	// which builds SharpFetch.Core against those TFMs (compile-verification
	// only - no CLI entry point ships for them, see ci.yml).
	"postCreateCommand": "sudo apt-get update && sudo apt-get install -y clang zlib1g-dev && dotnet workload install android wasm-tools && dotnet restore SharpFetch.slnx"

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
